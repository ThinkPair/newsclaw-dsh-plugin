{
  "name": "@newsclaw/dsh-plugin",
  "description": "新闻爪（NewsClaw）DeepSeek Harness 客户端：新闻推荐、惊喜推荐、内容库、画像、对话、消息与 22 个 Agent Bridge 工具。",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && tsdown --env.DSH_BUILD_FACE client",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "test": "node --test tests/*.test.mjs",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/node": "^24.0.0",
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/schemastery": "3.18.1",
    "lightningcss": "^1.30.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "skills/newsclaw-adapter/SKILL.md",
    "LICENSE",
    "NOTICE",
    "licenses/*.txt"
  ],
  "license": "BSD-3-Clause"
}
